[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = CellBootStub
  FILE_GUID                      = 820297A8-4BFB-4AD8-A3E2-FCD12D719763
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = CellBootStubEntry

[Sources]
  CellBootStub.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiLib

[BuildOptions]
  *_*_*_CC_FLAGS = -Wall -Wextra -Wno-unused-parameter
