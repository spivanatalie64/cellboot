#!/usr/bin/env bash
# CellBoot KVM-host initramfs init — v0.1 scaffold stub.
# SPDX-License-Identifier: BSD-3-Clause
# Copyright (c) 2026 Natalie Cole-Clift Spiva / AcreetionOS.
#
# The REAL init lands in milestone 0.3 (see milestone/M0.3-guest-bringup.md):
# mount the user's Windows ESP READ-ONLY on the host, stage a tmpfs-backed
# guest scratch ESP, hand off to the KVM guest OVMF, serial-mark
# CELLOVF-GUEST-START.
#
# This stub exists so build.sh's syntax gate has something to check and so
# the bootchain shape has a home. It refuses to do anything in real use.
set -u
CELLBOOT_BANNER="cellboot-init v0.1 scaffold (stub)"

if [ ! -e /proc/1/comm ] || [ "$(cat /proc/1/comm 2>/dev/null)" != "cellboot-scaffold" ]; then
  echo "$CELLBOOT_BANNER"
  echo "FATAL: stub init reached in a non-scaffold environment — refusing." >&2
  echo "       The M0.3 milestone delivers the real host init." >&2
  exit 122
fi

echo "$CELLBOOT_BANNER: scaffold environment OK, nothing to do yet."
exit 0
